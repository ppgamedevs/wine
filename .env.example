# Turso (libSQL) connection. Create a database later with the Turso CLI:
#   turso db create vinintel
#   turso db show vinintel --url
#   turso db tokens create vinintel
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# AI Sommelier (xAI Grok + Hugging Face embeddings)
XAI_API_KEY="your-xai-api-key"
HF_TOKEN="your-huggingface-api-token"

# Offline Prompt 27B content translation uses the server-only XAI_API_KEY above.
I18N_TRANSLATION_MODEL="grok-4.20-non-reasoning"

# Keep false until npm run i18n:audit reports complete English coverage.
ENGLISH_INDEXING_ENABLED="false"

# Local BotID fixture only. Vercel deployments ignore this value.
# Supported values: HUMAN, BAD-BOT, GOOD-BOT, ALLOWED.
BOTID_DEV_BYPASS="HUMAN"

# Local development fallback: leave Turso values empty to use file:local.db

# Wine photos: set image_url per wine (winery site or Vercel Blob). No placeholder stock URLs.

# Admin panel (/admin/wines) - set a strong secret locally and on Vercel
ADMIN_SECRET="your-admin-secret"

# Report notifications (logging always on; email optional via Resend)
ENABLE_REPORT_NOTIFICATIONS="true"
RESEND_API_KEY="re_xxxxxxxx"
REPORT_NOTIFICATION_EMAIL="somelier@vinintel.ro"
CONTACT_FORM_EMAIL="somelier@vinintel.ro"
RESEND_FROM_EMAIL="VinIntel <noreply@vinintel.ro>"

# Wine approval emails use the same RESEND_API_KEY and RESEND_FROM_EMAIL as above.

# Google Analytics 4 (optional; loads only when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-3YCX1F84DW"

# Stripe Premium checkout
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe webhook events (Dashboard > Webhooks):
# checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, customer.subscription.updated, customer.subscription.deleted

# Optional: use pre-created Stripe Price IDs instead of inline price_data
# STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_..."
# STRIPE_PREMIUM_ANNUAL_PRICE_ID="price_..."

# Required for /api/cron/premium-emails. The route fails closed when missing.
CRON_SECRET="your-cron-secret"

# Secondary score rollout. Missing/invalid values fail safe to shadow.
# legacy  = stored Gift/Food display and legacy ranking
# shadow  = legacy public behavior; v2 diagnostics only
# display = v2 Gift/Food display with safeguards; legacy ranking
# live    = v2 Gift/Food display and explicitly supported v2 ranking
SECONDARY_SCORING_MODE="shadow"

# Occasion Match is independently gated and defaults to internal.
OCCASION_MATCH_MODE="internal"

# Sommelier grounding: suppress recommendations when the catalog has no honest
# match (named wine missing, empty result, budget excludes everything).
# off     = legacy behaviour (always try to recommend something)
# enforce = recommend only wines that actually pass the request (default)
SOMMELIER_GROUNDING="enforce"

# TypeSafe Jev integration (server-side only; never prefix with NEXT_PUBLIC_).
# JEV_MODE defaults to off even when a key exists.
# off    = no external calls, existing behaviour unchanged
# shadow = Jev evaluates requests, results are logged only
# live   = validated Jev intent may fill gaps the deterministic parser left open
JEV_MODE="off"
TYPESAFE_API_KEY=""
# Optional tuning (defaults shown).
# JEV_MODEL="jev-latest"
# JEV_TIMEOUT_MS="6000"
# JEV_MAX_RETRIES="1"
# JEV_MIN_CONFIDENCE="0.55"
# JEV_CACHE_TTL_MS="300000"
# JEV_CACHE_MAX_ENTRIES="200"
# JEV_MAX_CONCURRENT="3"
# JEV_PERSONALIZATION="off"   # off | shadow (live not supported yet)
# JEV_PROVENANCE_TRIAGE="false"

# IndexNow (Bing/Yandex) - key file must exist at public/{INDEXNOW_KEY}.txt
INDEXNOW_KEY="c1b4c8cba7f2461fb39ff7cf3e44c247"
